<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- Match HomePage's spark-dark (#0f0f18) canvas with
             light-on-dark system bar icons so there is no flash of
             default system chrome while the JS StatusBar plugin is still
             booting. Other pages push spark-surface (and similar) onto
             the runtime status-bar stack as they render. -->
        <item name="android:statusBarColor">@color/spark_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/spark_dark</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <!-- Cold-launch window background. @drawable/splash_window is
             a layer-list (built by `make assets`) that fills with
             spark-dark and centers the per-density splash_logo bitmap
             at its intrinsic size. A raw full-screen bitmap here would
             be stretched by Android to fill the (typically tall
             portrait) window, surfacing as a vertically-stretched,
             blurry logo. This is the whole splash on pre-12 devices;
             on Android 12+ the system splash below covers it. -->
        <item name="android:background">@drawable/splash_window</item>
        <item name="android:statusBarColor">@color/spark_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/spark_dark</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- Android 12+ composes its own system splash over the launch
             window and takes its background from the splash-screen
             theme attribute alone; it cannot lift a color from the
             @drawable window background, so without this it falls back
             to the system Light/Dark default and flashes a light
             canvas in Light mode. Theme.SplashScreen applies this on
             API 31+ and emulates it below. -->
        <item name="windowSplashScreenBackground">@color/spark_dark</item>
        <!-- On Android 12+ the system splash icon, not the window
             background, is what stays on screen for the plugin's
             launchShowDuration. Left unset it falls back to the
             launcher icon: a 108dp bitmap the system upscales ~2x
             into its splash icon container, which renders visibly
             blurry. splash_icon ships per density at the platform's
             288dp spec size, so it only ever draws at or below its
             native resolution. -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
</resources>