<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>Glow</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<!-- Portrait only on iPhone and iPad. The glow-web layout is
	     designed and tested in portrait; landscape introduces
	     responsive-layout issues (balance display collision,
	     bottom-bar wrapping, QR scanner crop, etc.) that aren't
	     worth addressing for a phone-first wallet app. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<key>NSFaceIDUsageDescription</key>
	<string>Authenticate with Face ID to access your wallet via passkey</string>
	<key>NSCameraUsageDescription</key>
	<string>Glow uses the camera to scan Lightning and Bitcoin payment QR codes.</string>
	<!-- App Store export compliance (Phase 4C). Setting this to false
	     skips the encryption-export questionnaire on every TestFlight
	     upload — a hard requirement for `upload_to_testflight` to
	     succeed without per-build manual review.

	     Glow uses only Apple-provided cryptographic primitives
	     (TLS via URLSession, Keychain SecAccessControl) plus
	     wallet-domain crypto (BIP32/BIP39 + secp256k1) that falls
	     under the "exempt" category for cryptocurrency wallets and
	     authentication-only use. No proprietary encryption
	     algorithms travel outside the app. If we ever ship custom
	     encryption (e.g., E2E messaging), revisit and either set
	     this to true + answer the questionnaire, or add a CCATS-
	     equivalent exemption note here. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
