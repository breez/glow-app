<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>Glow</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<!-- Payment deep links, tracking Misty Breez minus the schemes Glow
	     can't service, plus one it can.

	     lnurlp / lnurlw / keyauth are the LUD-17 schemes. lnurlc
	     (LNURL-channel) is deliberately absent even though Misty claims
	     it: Glow has no channel flow, so taking the link would only
	     dead-end it away from an app that can service it.

	     bitcoin (BIP-21) goes the other way, claimed even though Misty
	     doesn't, because Glow can actually settle one: the send sheet
	     unwraps the URI to its underlying method and runs the on-chain
	     flow.

	     The uppercase duplicates are load-bearing, not noise: bech32 QR
	     codes are commonly encoded all-caps for QR density, so real
	     scanners hand off `LIGHTNING:LNBC...`, and iOS matches
	     CFBundleURLSchemes case-sensitively. `glow` gets no uppercase
	     twin because nothing QR-encodes it.

	     The SDK's parser takes these URIs whole, scheme prefix included.
	     `glow` is our own scheme and is stripped on the web side before
	     parsing. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>technology.breez.glow.payments</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>lightning</string>
				<string>bitcoin</string>
				<string>lnurlp</string>
				<string>lnurlw</string>
				<string>keyauth</string>
				<string>LIGHTNING</string>
				<string>BITCOIN</string>
				<string>LNURLP</string>
				<string>LNURLW</string>
				<string>KEYAUTH</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>technology.breez.glow</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>glow</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- Schemes canOpenURL is allowed to ask about. iOS answers false for
	     anything not declared here, whatever is actually installed, and
	     reports no error — so without this list glow-web's Cash App probe
	     (src/hooks/useCashAppInstalled.ts) silently decides Cash App is
	     absent and hides the entry on every device. Cash App publishes no
	     scheme of its own, so both the widely cited `cashme` and the Square
	     Cash-era `squarecash` are declared and the probe takes whichever
	     answers first. Apple caps this list at 50 entries; we use two. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>cashme</string>
		<string>squarecash</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<!-- Portrait only on iPhone and iPad. The glow-web layout is
	     designed and tested in portrait; landscape introduces
	     responsive-layout issues (balance display collision,
	     bottom-bar wrapping, QR scanner crop, etc.) that aren't
	     worth addressing for a phone-first wallet app. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<!-- Glow's UI is dark-only (CSS), but without this key the UIKit
	     environment follows the device appearance. On a light-mode
	     device, system overlay windows (the Face ID prompt, alerts)
	     then drive the status bar to light-appearance dark icons,
	     invisible over the dark WebView. Pinning the native style
	     dark keeps status icons light and renders system chrome
	     (Face ID dialog, share sheet, keyboard) dark to match. -->
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<!-- Consumed by the app-lock biometric gate and the legacy
	     biometric-bound seed tier. The passkey ceremony goes through
	     ASAuthorization and never reads this string, so it must not
	     describe passkeys: a user denying it based on the wrong
	     description can only undo that in iOS Settings. -->
	<key>NSFaceIDUsageDescription</key>
	<string>Use Face ID to unlock Glow and to protect your recovery phrase on this device.</string>
	<key>NSCameraUsageDescription</key>
	<string>Glow uses the camera to scan Lightning and Bitcoin payment QR codes.</string>
	<!-- App Store export compliance (Phase 4C). Setting this to false
	     skips the encryption-export questionnaire on every TestFlight
	     upload — a hard requirement for `upload_to_testflight` to
	     succeed without per-build manual review.

	     Glow uses only Apple-provided cryptographic primitives
	     (TLS via URLSession, Keychain SecAccessControl) plus
	     wallet-domain crypto (BIP32/BIP39 + secp256k1) that falls
	     under the "exempt" category for cryptocurrency wallets and
	     authentication-only use. No proprietary encryption
	     algorithms travel outside the app. If we ever ship custom
	     encryption (e.g., E2E messaging), revisit and either set
	     this to true + answer the questionnaire, or add a CCATS-
	     equivalent exemption note here. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
