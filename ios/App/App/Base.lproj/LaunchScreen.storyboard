<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="17132" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="01J-lp-oVM">
    <device id="retina4_7" orientation="portrait" appearance="light"/>
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="17105"/>
        <capability name="System colors in document resources" minToolsVersion="11.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <!--View Controller-->
        <scene sceneID="EHf-IW-A2E">
            <objects>
                <viewController id="01J-lp-oVM" sceneMemberID="viewController">
                    <!-- The mark is centred at a fixed 144pt, not fitted to the
                         screen. A full-bleed image with scaleAspectFit renders
                         the mark as a fixed fraction of device width, so it
                         disagrees with the fixed-size logo the WebView paints
                         next on every screen except one, and the launch visibly
                         resizes it (issue #122). 144pt is MARK_BOX_DP in
                         scripts/prepare-native-assets.mjs. -->
                    <view key="view" contentMode="scaleToFill" id="snD-IY-ifK">
                        <rect key="frame" x="0.0" y="0.0" width="375" height="667"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="Splash" translatesAutoresizingMaskIntoConstraints="NO" id="Glo-mk-001">
                                <rect key="frame" x="115.5" y="261.5" width="144" height="144"/>
                                <constraints>
                                    <constraint firstAttribute="width" constant="144" id="Glo-w-001"/>
                                    <constraint firstAttribute="height" constant="144" id="Glo-h-001"/>
                                </constraints>
                            </imageView>
                        </subviews>
                        <!-- #0f0f18 Glow canvas color (15/255, 15/255, 24/255).
                             Matches HomePage's spark-dark background.
                             systemBackgroundColor resolves to white on light-mode
                             iOS, producing a visible white flash behind the
                             splash image during cold launch. A fixed color
                             removes the flash entirely. -->
                        <color key="backgroundColor" red="0.05882352941" green="0.05882352941" blue="0.09411764706" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <constraints>
                            <constraint firstItem="Glo-mk-001" firstAttribute="centerX" secondItem="snD-IY-ifK" secondAttribute="centerX" id="Glo-cx-001"/>
                            <constraint firstItem="Glo-mk-001" firstAttribute="centerY" secondItem="snD-IY-ifK" secondAttribute="centerY" id="Glo-cy-001"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="iYj-Kq-Ea1" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="53" y="375"/>
        </scene>
    </scenes>
    <resources>
        <image name="Splash" width="144" height="144"/>
    </resources>
</document>
