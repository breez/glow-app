node_modules/
dist/

# Capacitor native build artifacts
ios/App/Pods/
.gradle/
android/app/build/
android/build/
android/.idea/
android/local.properties

# Root-level /build/ — iOS xcodebuild output from
# scripts/ci/build-ios-ipa.sh. CI and local test runs write
# the .xcarchive + .ipa + exportOptions.plist here. Anchored to
# repo root so it doesn't match intentional nested build/ dirs.
/build/

# Xcode Swift Package Manager local state per plugin. Generated
# by Xcode on open; not shareable across machines.
plugins/*/.swiftpm/

# Plugin Package.resolved is library-side SwiftPM lockfile state.
# The consuming app at ios/App/ pins versions; committing it here
# would only create false-conflict noise across developers.
plugins/*/Package.resolved

# Environment
.env
.env.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
/plugins/capacitor-passkey-prf/.build
/plugins/capacitor-native-vault/.build

# @capacitor/assets emits PWA icon output at repo root even when --ios --android
# flags are passed. We only use iOS + Android outputs; the PWA belongs to glow-web.
/icons/

# Signing material (Phase 4C) — NEVER commit any of these. Certs,
# provisioning profiles, keystores, and service-account JSONs are
# either downloaded locally for secret generation or written by CI
# from GitHub secrets at $RUNNER_TEMP paths.
*.mobileprovision
*.p12
*.p8
*.jks
*.keystore
play-service-account.json