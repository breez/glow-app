{
  "name": "glow-app",
  "version": "0.1.15",
  "description": "Native iOS/Android wrapper for [Glow](https://github.com/breez/glow-web) — a Bitcoin/Lightning wallet powered by the Breez Spark SDK.",
  "private": true,
  "scripts": {
    "build:web": "cd glow-web && npm run build",
    "sync": "npx cap sync",
    "build": "npm run build:web && npm run sync",
    "open:ios": "npx cap open ios",
    "open:android": "npx cap open android",
    "version": "sed -i '' \"s/MARKETING_VERSION = [^;]*;/MARKETING_VERSION = $npm_package_version;/g\" ios/App/App.xcodeproj/project.pbxproj && git add ios/App/App.xcodeproj/project.pbxproj",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/cli": "^8.3.0",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.3.0",
    "@capacitor/device": "^8.0.3",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.3.0",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/privacy-screen": "^2.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@capgo/capacitor-navigation-bar": "^8.2.6",
    "capacitor-native-vault": "file:plugins/capacitor-native-vault",
    "capacitor-passkey-prf": "file:plugins/capacitor-passkey-prf"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "patch-package": "^8.0.1",
    "sharp": "^0.35.1",
    "typescript": "^6.0.3"
  }
}
